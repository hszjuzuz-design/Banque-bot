# Client ID de l'application (Discord Developer Portal > General Information > Application ID)
CLIENT_ID=1530605743416545361

# ID du serveur Discord pour tester les commandes instantanément (clic droit sur le serveur > Copier l'identifiant)
GUILD_ID=879303768661983252

# Nom de la devise affichée dans le bot
CURRENCY_NAME=Euro 
CURRENCY_SYMBOL=💰

# Chemin de la base SQLite. En local, laisse vide (fichier créé à la racine).
# Sur Railway, mets le chemin de ton volume persistant, ex: /data/banque.sqlite
DB_PATH=

# Ton ID Discord (clic droit sur ton profil > Copier l'identifiant utilisateur, mode développeur requis)
# Seul ce compte a accès au panel propriétaire (illimité, tous serveurs, en MP uniquement)
OWNER_ID=879297912515985458

# Message secret à envoyer en MP au bot pour ouvrir ton panel propriétaire.
# Ce n'est PAS un slash command : il n'apparaît nulle part dans le picker "/", personne ne peut le découvrir.
OWNER_PANEL_TRIGGER=!panel

# Nom exact du rôle Discord donnant accès à /createur-panel (accès limité, un seul serveur).
# Ce rôle est créé automatiquement par le bot quand tu identifies les créateurs d'un serveur.
CREATEUR_ROLE_NAME=Président

# Limites du panel Créateur (en unités de devise)
CREATEUR_LIMITE_PAR_ACTION=5000
CREATEUR_LIMITE_QUOTIDIENNE=20000
